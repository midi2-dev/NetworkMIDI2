# nm2_test.env.example — copy to nm2_test.env and fill in your values,
# then `source nm2_test.env` before running nm2_test_all.py.
# nm2_test.env is gitignored; this file is safe to commit.

# LAN IP of the Linux/Pi test host running nm2_interactive
export NM2_PI_IP="192.168.1.50"

# SSH login for the Pi host
export NM2_PI_USER="pi"
export NM2_PI_KEY="$HOME/.ssh/id_rsa"

# Path to nm2_interactive on the Pi (defaults to /home/$NM2_PI_USER/NetworkMIDI2/build/...)
# export NM2_PI_BINARY="/home/pi/NetworkMIDI2/build/examples/midi_bridge/nm2_interactive"

# LAN IP of this Mac (used when Mac is the session host)
export NM2_MAC_LAN_IP="192.168.1.10"

# Serial devices for Pico A and Pico B (defaults shown; Linux uses /dev/ttyACM0 etc.)
export NM2_PICO_A_DEV="/dev/ttyACM0"
export NM2_PICO_B_DEV="/dev/ttyACM1"
